# Copy to frontend/.env.local and adjust. All values are optional.

# Where the Vite dev server proxies /api requests (dev only).
VITE_PROXY_TARGET=http://localhost:8080

# Absolute API URL baked into the build. Leave empty to use relative /api URLs
# (works with the dev proxy and the nginx container). Set it only if the API is
# hosted on another origin, and add that frontend origin to CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=
