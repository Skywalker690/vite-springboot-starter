# Copy to backend/.env and adjust. All values are optional.
# Variables are prefixed (DB_*) so they don't clash with OS variables like USERNAME.

PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Leave DB_URL unset to use the in-memory H2 database.
# DB_URL=jdbc:mysql://localhost:3306/app?createDatabaseIfNotExist=true
# DB_USERNAME=root
# DB_PASSWORD=secret
